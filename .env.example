# ─────────────────────────────────────────────────────────────────────────────
#  RAG Wiki configuration
#
#  Local development: copy to backend/.env and fill in.
#  Vercel: set the same keys as Project -> Settings -> Environment Variables.
#  Every value below is validated at startup by backend/src/config/env.ts, so a
#  missing or malformed variable fails immediately with a named error rather
#  than at the first request that needs it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# ── Postgres (Neon free tier works; the pgvector extension is required) ──────
# Use the POOLED connection string on serverless: each invocation is its own
# instance, and the direct string exhausts the connection limit under load.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/ragwiki?sslmode=require

# ── Redis (Upstash free tier works) ──────────────────────────────────────────
# Must be the RESP URL (rediss://...), NOT the https:// REST URL shown first on
# the Upstash dashboard. Look for "Redis Connect" / "redis-cli" on that page.
REDIS_URL=rediss://default:password@region.upstash.io:6379

# ── Model provider (OpenRouter) ──────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# ── Public origin ────────────────────────────────────────────────────────────
# Used for CORS and for OpenRouter usage attribution. In production this is the
# deployed URL, e.g. https://rag-wiki.vercel.app
APP_URL=http://localhost:5173
# Optional extra browser origins, comma separated. APP_URL is always allowed.
CORS_ORIGINS=

# ── Retrieval and chunking ───────────────────────────────────────────────────
# EMBED_DIMENSIONS must match the vector(N) column width in the migrations, and
# pgvector caps an HNSW index at 2000.
EMBED_DIMENSIONS=1536
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RESULTS=5

# Vercel rejects request bodies above 4.5MB, so keep this under that ceiling on
# a serverless deployment. Self-hosted deployments can raise it.
MAX_FILE_SIZE_MB=4

# ── Abuse and cost control ───────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# The model calls are the only part that costs money, so they get their own,
# much stricter budget.
LLM_RATE_LIMIT_WINDOW_MS=3600000
LLM_RATE_LIMIT_MAX=10

# Uploads bill an embedding for every chunk, so they get their own, much
# tighter budget. Unlike the general rate limiter, this one does not fail open:
# if Redis is unreachable it keeps counting in-process.
INGEST_RATE_LIMIT_WINDOW_MS=3600000
INGEST_RATE_LIMIT_MAX=3

# Ceiling on billed embeddings per upload. A file can pass MAX_FILE_SIZE_MB and
# still be hundreds of pages of plain text.
MAX_CHUNKS_PER_DOCUMENT=400

# ── Caching (seconds) ────────────────────────────────────────────────────────
CACHE_TTL_QUERY=3600
CACHE_TTL_EMBEDDING=86400
CACHE_TTL_RETRIEVAL=1800

# ── Public demo hardening ────────────────────────────────────────────────────
# With DEMO_MODE on, destructive endpoints require the X-Admin-Token header, so
# a visitor cannot delete the seeded collections. ADMIN_TOKEN is then required
# and must be at least 16 characters.
DEMO_MODE=false
ADMIN_TOKEN=

# Collections that ingestion refuses to write into while DEMO_MODE is on, comma
# separated. Ingest upserts by name, so without this a visitor can merge their
# own document into the curated demo collection. Defaults to the seeded one.
PROTECTED_COLLECTIONS=
